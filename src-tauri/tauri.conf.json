{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "winClock",
  "version": "0.1.0",
  "identifier": "com.hierru.winclock",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "winClock",
        "width": 480,
        "height": 250,
        "minWidth": 180,
        "minHeight": 100,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
